# LLM Provider (OpenAI-compatible API)
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Examples:
# OpenAI:         LLM_API_BASE=https://api.openai.com/v1        LLM_MODEL=gpt-4o
# 通义千问:        LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# DeepSeek:       LLM_API_BASE=https://api.deepseek.com/v1       LLM_MODEL=deepseek-chat
# Agnes AI (free):LLM_API_BASE=https://agnes-ai.cn/v1           LLM_MODEL=agnes-3-flash
# Claude (proxy): LLM_API_BASE=http://localhost:8080/v1         LLM_MODEL=claude-sonnet-4-5-2025-0514

# Server port
PORT=3000
