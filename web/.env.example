# Frontend build-time settings (Vite loads web/.env automatically; .env is gitignored)

# Backend API URL for the static deploy (GitHub Pages).
# Leave empty during local dev (Vite proxies /api to localhost:3000).
# For the deployed site, set it to your hosted backend, e.g.:
# VITE_API_BASE=https://your-agent-server.onrender.com
VITE_API_BASE=