.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.messages {
  flex: 1;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  color: #64748b;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #1a1a2e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #6366f1;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #64748b;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-user {
  justify-content: flex-end;
}

.msg-assistant {
  justify-content: flex-start;
}

.bubble {
  max-width: 85%;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.bubble-user {
  background: #6366f1;
  color: #fff;
}

.bubble-assistant {
  background: #1a1a2e;
  color: #e2e8f0;
}

.thinking {
  color: #64748b;
  font-style: italic;
}

/* Tool calls */
.tool-calls {
  margin-top: 16rpx;
}

.tool-card {
  background: #252538;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  overflow: hidden;
}

.tool-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
}

.tool-name {
  color: #94a3b8;
  font-weight: 500;
}

.tool-status {
  font-size: 22rpx;
  color: #6366f1;
}

.tool-detail {
  padding: 12rpx 16rpx;
  border-top: 1rpx solid #334155;
  font-size: 22rpx;
  color: #64748b;
  word-break: break-all;
}

.tool-args {
  display: block;
  margin-bottom: 8rpx;
}

/* Input area */
.input-area {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #0f0f17;
  border-top: 1rpx solid #252538;
}

.input {
  flex: 1;
  background: #1a1a2e;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #e2e8f0;
}

.btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  border: none;
  padding: 0;
  line-height: 1;
}

.btn-send {
  background: #6366f1;
  color: #fff;
}

.btn-send.active {
  opacity: 1;
}

.btn-stop {
  background: rgba(239, 68, 68, 0.2);
  color: #ef4444;
}
